# DO NOT use placeholder values in production
PORT=3001
HROS_USERNAME=admin
HROS_PASSWORD=replace-with-a-strong-unique-password
SESSION_SECRET=replace-with-32-plus-random-characters
DATABASE_PATH=/data/hros.db
TELEPHONY_MODE=mock
PUBLIC_CALLING_ENABLED=false
MAX_CONCURRENT_CALLS=1
MIN_SECONDS_BETWEEN_CALLS=2
MOCK_ONLY=true
ASTRISK_ARI_URL=http://asterisk:8088/ari
ASTRISK_ARI_USER=hros
ASTRISK_ARI_PASSWORD=replace-with-secret
ASTRISK_APP=hros
ASTRISK_CALLER_ID=
CALL_WEBHOOK_SECRET=replace-with-independent-secret

# Infobip Calls API (requires a publicly reachable HTTPS webhook)
# INFOBIP_BASE_URL=https://ndlev2.api.infobip.com
# INFOBIP_API_KEY=replace-with-private-infobip-api-key
# INFOBIP_CALLS_CONFIGURATION_ID=hros-outbound-test-01
# INFOBIP_FROM_NUMBER=replace-with-authorized-infobip-voice-number
# INFOBIP_WEBHOOK_USERNAME=replace-with-webhook-username
# INFOBIP_WEBHOOK_PASSWORD=replace-with-independent-webhook-password
# INFOBIP_LANGUAGE=en
# Enable only for an explicitly authorized, single-number test:
# TELEPHONY_MODE=infobip
# PUBLIC_CALLING_ENABLED=true
# MOCK_ONLY=false

# Required only by optional local SIP profile
SIP_1001_PASSWORD=replace-with-local-sip-secret
SIP_1002_PASSWORD=replace-with-different-local-sip-secret
CLIENT_ORIGIN=http://localhost:5173
