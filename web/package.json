    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.1",
    "eslint": "9.35.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vite": "7.1.4",
    "vitest": "3.2.4",
    "jsdom": "26.1.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/jest-dom": "6.8.0",
    "@playwright/test": "1.55.0"
  }
