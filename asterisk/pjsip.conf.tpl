[global]
type=global
user_agent=HROS Local Test
[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
[1001]
type=endpoint
context=local
disallow=all
allow=ulaw
auth=1001-auth
aors=1001-aor
direct_media=no
[1001-auth]
type=auth
auth_type=userpass
username=1001
password=$SIP_1001_PASSWORD
[1001-aor]
type=aor
max_contacts=1
remove_existing=yes
[1002]
type=endpoint
context=local
disallow=all
allow=ulaw
auth=1002-auth
aors=1002-aor
direct_media=no
[1002-auth]
type=auth
auth_type=userpass
username=1002
password=$SIP_1002_PASSWORD
[1002-aor]
type=aor
max_contacts=1
remove_existing=yes
